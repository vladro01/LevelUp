# Dependencies - Docker installs these fresh inside the container
node_modules

# Environment files - never bake secrets into images
.env
.env.*
!.env.example

# Git history - not needed in production image
.git
.gitignore

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode
.idea
*.swp

# Docker files themselves
Dockerfile
docker-compose*.yml

# Test files - not needed in production image
*.test.js
*.spec.js
__tests__/
coverage/
